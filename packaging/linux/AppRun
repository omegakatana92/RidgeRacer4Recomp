#!/bin/sh
set -eu

if [ -z "${APPDIR:-}" ]; then
    echo "Ridge Racer 4 Recompiled: APPDIR is not set." >&2
    exit 1
fi

if [ -n "${RIDGERACER4_DATA_DIR:-}" ]; then
    data_dir="$RIDGERACER4_DATA_DIR"
elif [ -n "${XDG_DATA_HOME:-}" ]; then
    data_dir="$XDG_DATA_HOME/RidgeRacer4Recomp"
elif [ -n "${HOME:-}" ]; then
    data_dir="$HOME/.local/share/RidgeRacer4Recomp"
else
    echo "Ridge Racer 4 Recompiled: HOME is not set." >&2
    exit 1
fi

payload="$APPDIR/usr/share/ridgeracer4recomp"
runtime="$APPDIR/usr/bin/Ridge_Racer_4_Recompiled"

if [ ! -x "$runtime" ] || [ ! -f "$payload/game.toml" ]; then
    echo "Ridge Racer 4 Recompiled: AppImage payload is incomplete." >&2
    exit 1
fi

mkdir -p "$data_dir"
mkdir -p "$data_dir/saves"
mkdir -p "$data_dir/cache"
mkdir -p "$data_dir/mods"

# Copy release-owned resources into writable user storage.
for tree in assets bios; do
    if [ -d "$payload/$tree" ]; then
        mkdir -p "$data_dir/$tree"
        cp -a "$payload/$tree/." "$data_dir/$tree/"
        chmod -R u+rwX "$data_dir/$tree"
    fi
done

# Preserve user-generated cache data.
if [ -d "$payload/cache" ]; then
    mkdir -p "$data_dir/cache"
    cp -a -n "$payload/cache/." "$data_dir/cache/" 2>/dev/null || true
    chmod -R u+rwX "$data_dir/cache"
fi

# Preserve bundled mods while allowing user modifications.
if [ -d "$payload/mods" ]; then
    cp -a "$payload/mods/." "$data_dir/mods/"
    chmod -R u+rwX "$data_dir/mods"
fi

# Release configuration.
for file in game.toml LICENSE README.md RELEASE_NOTES.md START_HERE.txt; do
    if [ -f "$payload/$file" ]; then
        cp -f "$payload/$file" "$data_dir/$file"
        chmod u+rw "$data_dir/$file"
    fi
done

# User-owned input configuration.
if [ ! -f "$data_dir/input.ini" ] && [ -f "$payload/input.ini" ]; then
    cp "$payload/input.ini" "$data_dir/input.ini"
    chmod u+rw "$data_dir/input.ini"
fi

if [ ! -f "$data_dir/keybinds.ini" ] && [ -f "$payload/keybinds.ini" ]; then
    cp "$payload/keybinds.ini" "$data_dir/keybinds.ini"
    chmod u+rw "$data_dir/keybinds.ini"
fi

# Anchor runtime paths to writable storage.
launcher="$data_dir/.Ridge_Racer_4_Recompiled-runtime"
ln -sfn "$runtime" "$launcher"

export RIDGERACER4_APPIMAGE_PATH="${APPIMAGE:-}"
unset APPIMAGE

export PATH="$APPDIR/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

cd "$data_dir"
exec "$launcher" --game "$data_dir/game.toml" "$@"
